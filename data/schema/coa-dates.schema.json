{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dates and identifiers read from published documents",
  "type": "object",
  "required": [
    "about",
    "certificates"
  ],
  "additionalProperties": false,
  "properties": {
    "about": {
      "type": "string"
    },
    "certificates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "lab",
          "sampled",
          "sampledFrom",
          "packaged",
          "harvested"
        ],
        "additionalProperties": false,
        "properties": {
          "lab": {
            "type": [
              "string",
              "null"
            ]
          },
          "unread": {
            "type": [
              "string",
              "null"
            ]
          },
          "sampleId": {
            "type": [
              "string",
              "null"
            ]
          },
          "batchTag": {
            "type": [
              "string",
              "null"
            ]
          },
          "lotNumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "metrcTag": {
            "type": [
              "string",
              "null"
            ]
          },
          "sampled": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "packaged": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "harvested": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "sampledFrom": {
            "enum": [
              "sampled",
              "received",
              "tested",
              "reported",
              null
            ],
            "description": "The actual event label in the document; this is not a packaging date."
          },
          "packagedFrom": {
            "enum": [
              "document",
              "metrc-retail-id",
              null
            ],
            "description": "Explicit packaging date in the document or printed Metrc card; never inferred from expiry."
          },
          "harvestedFrom": {
            "enum": [
              "document-harvest-lot-id",
              null
            ],
            "description": "Explicit H:MM.DD.YY harvest code; cultivation dates are not harvest dates."
          },
          "sourceKind": {
            "enum": [
              "menu",
              "brand-page",
              "brand-page-unreviewed"
            ]
          },
          "sourcePage": {
            "type": "string",
            "format": "uri",
            "description": "Brand page on which this exact document URL was published."
          },
          "documentUrl": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "docType": {
            "type": [
              "string",
              "null"
            ]
          },
          "panel": {
            "type": [
              "object",
              "null"
            ],
            "description": "What the certificate measured, read by scripts/coa-panel.py: the strain or product it names, total THC, total terpenes and the leading terpenes, keyed as data/shelf-terpenes.json keys them. 0 is a measured not-found (ND, <LOQ). Null when the laboratory's layout is not one the reader knows.",
            "additionalProperties": false,
            "required": [
              "lab",
              "name",
              "matrix",
              "licence",
              "thc",
              "totalTerpenes",
              "terpenes"
            ],
            "properties": {
              "lab": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "matrix": {
                "enum": [
                  "flower",
                  "other",
                  null
                ],
                "description": "What the document says it tested."
              },
              "licence": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^OCM-[A-Z]{3,6}-\\d{2}-\\d{6}$",
                "description": "The client's New York licence the document prints (never the laboratory's own)."
              },
              "thc": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 50
              },
              "totalTerpenes": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 20
              },
              "terpenes": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20
                },
                "propertyNames": {
                  "enum": [
                    "MYRCENE",
                    "CARYOPHYLLENE",
                    "LIMONENE",
                    "LINALOOL",
                    "HUMULENE",
                    "PINENE_ALPHA",
                    "PINENE_BETA",
                    "TERPINOLENE",
                    "OCIMENE",
                    "BISABOLOL",
                    "FARNESENE"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
